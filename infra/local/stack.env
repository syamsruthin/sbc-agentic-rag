# Settings for running the API natively against the local stack (scripts/local/api.sh sources this file).
# Not secrets: endpoints, resource names and dummy AWS credentials for the stand-ins. Secrets (OpenRouter keys,
# Langfuse keys) come from .env, and bootstrap puts them into the local Parameter Store under SSM_PREFIX.
# Values that bootstrap generates (the Cognito pool and client IDs, the demo user's sub) are in .local/runtime.env.
# The api container (infra/local/compose.yaml, profile `image`) uses the same values with Docker host names.

APP_ENV=local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000
AWS_ENDPOINT_URL_S3=http://localhost:9090
AWS_ENDPOINT_URL_SSM=http://localhost:5050
AWS_ENDPOINT_URL_COGNITO_IDENTITY_PROVIDER=http://localhost:5050

DDB_TABLE_APP=sbc-local-app
DDB_TABLE_AUDIT=sbc-local-audit
DDB_TABLE_CHECKPOINTS=sbc-local-checkpoints
S3_DATA_BUCKET=sbc-local-data
SSM_PREFIX=/sbc/local/
PUBLIC_BASE_URL=http://localhost:8088

FACTS_BUNDLE_PATH=bundles/facts-2027.2.sqlite

# Portfolio limits, on for the full stack only (plain APP_ENV=local runs keep them off, config/env/local.yaml):
# the dev values scaled down so each guard can be tripped by hand. The demo user's sub comes from bootstrap
# (SBC_PORTFOLIO__DEMO_USER_IDS in .local/runtime.env).
SBC_PORTFOLIO__GLOBAL_DAILY_LLM_TURNS=200
SBC_PORTFOLIO__DEMO_RATE_LIMITS__PER_MINUTE=5
SBC_PORTFOLIO__DEMO_RATE_LIMITS__PER_DAY=30
