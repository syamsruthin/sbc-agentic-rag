# Environment variables for plan-info-chatbot.
# Copy to .env for local development. Never commit real values.
# On AWS, secrets live in SSM Parameter Store under SSM_PREFIX and the API loads them at cold start; the
# resource names below are set on the Lambda function by the CDK stack (docs/aws/MIGRATION_PLAN.md 6.4).

# --- App ---
# local | dev | prd
APP_ENV=local
LOG_LEVEL=INFO

# --- OpenRouter: LLMs, embeddings and rerank (one key per bot, each with a credit limit). Secrets. ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY_BROKER=
OPENROUTER_API_KEY_PUBLIC=

# --- Facts bundle: structured SBC facts and the text-search index (SQLite, read-only) ---
FACTS_BUNDLE_PATH=bundles/facts.sqlite

# --- AWS resources (names and IDs, not secrets; required in dev and prd) ---
AWS_REGION=us-east-1
# Parameter Store path holding the secrets in this file, e.g. /sbc/dev/
SSM_PREFIX=
DDB_TABLE_APP=
DDB_TABLE_AUDIT=
DDB_TABLE_CHECKPOINTS=
S3_DATA_BUCKET=
# Broker auth: Cognito user pool and its SPA app client
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
# The public site (the CloudFront distribution URL)
PUBLIC_BASE_URL=http://localhost:5173

# --- Public bot (secrets) ---
# Locally, leave it empty to skip the bot check, or use Cloudflare's always-pass test secret
# (1x0000000000000000000000000000000AA, with site key 1x00000000000000000000AA).
TURNSTILE_SECRET_KEY=
# Signs anonymous session tokens; at least 32 bytes (e.g. `openssl rand -base64 48`). Optional locally.
SESSION_JWT_SECRET=

# --- Observability (optional: Langfuse tracing is on only when both keys are set) ---
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SENTRY_DSN=

# --- Frontends (Vite; these values are public by design, not secrets) ---
VITE_API_BASE_URL=/api
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_TURNSTILE_SITE_KEY=
