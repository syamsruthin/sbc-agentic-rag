# Environment variables for plan-info-chatbot.
# Copy to .env for local development, or run commands through `doppler run --`.
# Never commit real values. Shared and production secrets live in Doppler
# (synced to GCP Secret Manager for Cloud Run and to GitHub Actions for CI).

# --- App ---
# local | dev | prd
APP_ENV=local
LOG_LEVEL=INFO

# --- OpenRouter: LLMs, embeddings and rerank (one key per bot, each with a credit limit) ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY_BROKER=
OPENROUTER_API_KEY_PUBLIC=

# --- Facts bundle: structured SBC facts and the text-search index (SQLite, read-only) ---
FACTS_BUNDLE_PATH=bundles/facts.sqlite

# --- Supabase: broker auth and operational Postgres ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only; never expose to a frontend
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Connection pooler in transaction mode (port 6543)
DATABASE_URL=

# --- Upstash Redis: rate limits and caches (REST API) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Public bot ---
TURNSTILE_SECRET_KEY=
# Signs anonymous session tokens
SESSION_JWT_SECRET=

# --- Observability ---
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SENTRY_DSN=

# --- Frontends (Vite; these values are public by design, not secrets) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=
